; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Teenager Educational Game"
run/main_scene="res://landing-scences/landing.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://global/Global.gd"
PlayerStatus="*res://global/PlayerStatus.gd"
MiniGameController="*res://global/MiniGameController.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/Test.dialogue", "res://dialogues/BedObject.dialogue", "res://dialogues/TutorialObject.dialogue", "res://dialogues/DeskObject.dialogue", "res://dialogues/CafeObject.dialogue", "res://dialogues/CinemaObject.dialogue", "res://dialogues/ClassroomObject.dialogue", "res://dialogues/FriendObject.dialogue", "res://dialogues/BookshelfObject.dialogue", "res://dialogues/OutOfTime.dialogue", "res://dialogues/SleepTime.dialogue", "res://dialogues/testDateDialog.dialogue", "res://dialogues/notSleepTime.dialogue", "res://dialogues/startTestExam.dialogue", "res://dialogues/SleepOnExamDate.dialogue", "res://dialogues/EndgameDialog.dialogue")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
