; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Teenager Educational Game"
run/main_scene="res://landing-scences/landing.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Global="*res://global/Global.gd"
PlayerStatus="*res://global/PlayerStatus.gd"
MiniGameController="*res://global/MiniGameController.gd"
Tutorial="*res://global/Tutorial.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
ScenceTransition="*res://global/scence_transition.tscn"

[dialogue_manager]

general/balloon_path="res://custom-dialogues/balloon.tscn"
general/custom_test_scene_path="res://custom-dialogues/test_dialog.tscn"
general/new_template="~ start
set PlayerStatus.isOpenDialog = true

set PlayerStatus.isOpenDialog = false
=> END

"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/tutorial-bedroom-state-1.dialogue", "res://dialogues/tutorial-mainroad-state-1.dialogue", "res://dialogues/tutorial-classroom-state-1.dialogue", "res://dialogues/tutorial-object-classroom-state-1.dialogue", "res://dialogues/tutorial-object-friend-state-1.dialogue", "res://dialogues/tutorial-error.dialogue", "res://dialogues/tutorial-bedroom-state-2.dialogue", "res://dialogues/tutorial-object-tutorial-state-1.dialogue", "res://dialogues/tutorial-object-bedroom-state-1.dialogue", "res://dialogues/tutorial-bedroom-state-3.dialogue", "res://dialogues/tutorial-bedroom-state-4.dialogue", "res://dialogues/tutorial-classroom-state-2.dialogue", "res://dialogues/tutorial-object-bookshelf-1.dialogue", "res://dialogues/tutorial-cafe-state-1.dialogue", "res://dialogues/tutorial-cinema-state-1.dialogue", "res://dialogues/tutorial-object-cafe-1.dialogue", "res://dialogues/tutorial-object-cinema-1.dialogue", "res://dialogues/tutorial-bedroom-state-5.dialogue", "res://dialogues/tutorial-minigame.dialogue", "res://dialogues/tutorial-bedroom-state-6.dialogue", "res://dialogues/tutorial-object-desktop-1.dialogue", "res://dialogues/tutorial-bedroom-state-7.dialogue", "res://dialogues/tutorial-classroom-state-3.dialogue", "res://dialogues/tutorial-object-classroom-state-2.dialogue", "res://dialogues/tutorial-bedroom-state-8.dialogue", "res://dialogues/tutorial-object-friend-state-2.dialogue", "res://dialogues/tutorial-after-school-1.dialogue", "res://dialogues/tutorial-after-read-schedule.dialogue", "res://dialogues/tutorial-day2-after-classroom.dialogue", "res://dialogues/tutorial-day2-after-cafe.dialogue", "res://dialogues/tutorial-day2-after-cinema.dialogue", "res://dialogues/minigame_arcade_tutorial.dialogue", "res://dialogues/minigame_sport_tutorial.dialogue", "res://dialogues/tutorial-day3-to-arcade.dialogue", "res://dialogues/tutorial-day3-to-sport.dialogue", "res://dialogues/tutorial-day3-to-home.dialogue", "res://d