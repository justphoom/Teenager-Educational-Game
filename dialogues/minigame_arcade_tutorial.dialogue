~ start
set PlayerStatus.isOpenDialog = true
วิธีการเล่น "arcade"
ใช้ปุ่มบังคับทางด้านซ้ายเพื่อควบคุมตัวละคร
คุณต้องควบคุมตัวละครหลบเลี่ยงสิ่งต่างๆที่จะเข้ามา
คุณมีโอกาสพลาด 5 ครั้ง
ของรางวัลที่จะได้รับขึ้นอยู่กับเวลาที่คุณเอาชีวิตรอด
หากคุณเล่นในโหมดท้าทาย ของรางวัลก็จะมากขึ้น
do Tutorial.show_arcade_play_button()
set PlayerStatus.isOpenDialog = false
=> END